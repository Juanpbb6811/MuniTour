# ==============================================================
# MuniTour - .gitignore
# ==============================================================

# Compiled class files
*.class

# Log files
*.log

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Maven wrapper
.mvn/wrapper/maven-wrapper.jar

# IDE - IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# IDE - Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/

# IDE - VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Environment variables
.env
*.env

# Application properties with secrets
application-local.properties
application-prod.properties
